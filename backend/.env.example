# MySQL 8 connection — never commit real values
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=community_hall

# Admin seed (used by `npm run seed:admin` only; never committed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Auth / API
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_DAYS=30
PORT=5000
NODE_ENV=development
